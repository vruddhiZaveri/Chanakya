{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chanakya agent-output bundle",
  "type": "object",
  "required": [
    "proposition",
    "agents",
    "sources"
  ],
  "properties": {
    "proposition": {
      "type": "string",
      "minLength": 10
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "id",
          "position",
          "statement",
          "sourceIds"
        ],
        "properties": {
          "id": {
            "enum": [
              "researcher",
              "specialist",
              "challenger",
              "reviewer",
              "synthesizer"
            ]
          },
          "position": {
            "enum": [
              "support",
              "oppose",
              "uncertain"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 10
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "url",
          "excerpt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          },
          "organization": {
            "type": "string"
          },
          "date": {
            "type": "string"
          }
        }
      }
    }
  }
}